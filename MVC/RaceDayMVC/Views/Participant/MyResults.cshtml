@model List<RaceDayMVC.Models.ParticipantResultModel>

@{
    ViewData["Title"] = "My Results";
}

@functions {
    // 1 -> 1st, 2 -> 2nd, 3 -> 3rd, 11 -> 11th, 47 -> 47th
    private static string Ordinal(int number)
    {
        int lastTwo = number % 100;

        if (lastTwo >= 11 && lastTwo <= 13)
        {
            return number + "th";
        }

        return (number % 10) switch
        {
            1 => number + "st",
            2 => number + "nd",
            3 => number + "rd",
            _ => number + "th"
        };
    }
}

<h1>My Results</h1>

@if (ViewBag.ApiError != null)
{
    <div class="alert alert-danger">@ViewBag.ApiError</div>
}
else if (!Model.Any())
{
    <p class="text-muted">
        No published results yet. Results appear here after an organiser publishes them following your event.
    </p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Event</th>
                    <th>Date</th>
                    <th>Category</th>
                    <th>Finish time</th>
                    <th>Position</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.EventName</td>
                        <td>@item.EventDate.ToString("dd MMM yyyy")</td>
                        <td>@item.CategoryName</td>
                        <td>@item.FinishTime.ToString("c")</td>
                        <td>
                            @Ordinal(item.Position) out of @item.TotalFinishers @(item.TotalFinishers == 1 ? "finisher" : "finishers")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}