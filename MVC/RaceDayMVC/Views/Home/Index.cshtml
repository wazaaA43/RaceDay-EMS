@model RaceDayMVC.Models.EventFilterViewModel

@{
    ViewData["Title"] = "Upcoming Events";
}

<h1>Upcoming Events</h1>

<form asp-action="Index" method="get" class="card card-body mb-4">
    <div class="row g-2 align-items-end">
        <div class="col-md-3">
            <label for="search" class="form-label">Event name</label>
            <input id="search" name="search" value="@Model.Search" class="form-control" placeholder="e.g. Spring" />
        </div>
        <div class="col-md-2">
            <label for="type" class="form-label">Type</label>
            <select id="type" name="type" class="form-select">
                <option value="">All types</option>
                <option value="Run" selected="@(Model.Type == "Run")">Run</option>
                <option value="Walk" selected="@(Model.Type == "Walk")">Walk</option>
                <option value="Cycle" selected="@(Model.Type == "Cycle")">Cycle</option>
            </select>
        </div>
        <div class="col-md-2">
            <label for="location" class="form-label">Location</label>
            <input id="location" name="location" value="@Model.Location" class="form-control" placeholder="e.g. Pretoria" />
        </div>
        <div class="col-md-2">
            <label for="dateFrom" class="form-label">From</label>
            <input id="dateFrom" name="dateFrom" type="date" value="@(Model.DateFrom?.ToString("yyyy-MM-dd"))" class="form-control" />
        </div>
        <div class="col-md-2">
            <label for="dateTo" class="form-label">To</label>
            <input id="dateTo" name="dateTo" type="date" value="@(Model.DateTo?.ToString("yyyy-MM-dd"))" class="form-control" />
        </div>
        <div class="col-md-1 d-grid">
            <button type="submit" class="btn btn-primary">Filter</button>
        </div>
    </div>
    @if (Model.HasFilters)
    {
        <div class="mt-2">
            <a asp-action="Index" class="btn btn-link ps-0">Clear filters</a>
        </div>
    }
</form>

@if (ViewBag.ApiError != null)
{
    <div class="alert alert-danger">@ViewBag.ApiError</div>
}
else if (Model.TotalUpcoming == 0)
{
    <p class="text-muted">No upcoming events yet. Check back soon.</p>
}
else if (!Model.Events.Any())
{
    <p class="text-muted">No events match your filters. Try changing or clearing them.</p>
}
else
{
    <p class="text-muted">Showing @Model.Events.Count of @Model.TotalUpcoming upcoming events.</p>
}

<div class="row">
    @foreach (var item in Model.Events)
    {
        <div class="col-md-4 mb-3">
            <div class="card h-100">
                @if (!string.IsNullOrEmpty(item.BannerUrl))
                {
                    <img src="@item.BannerUrl" class="card-img-top" alt="Banner for @item.EventName" />
                }
                <div class="card-body">
                    <h5 class="card-title">@item.EventName</h5>
                    <p class="card-text">@item.Description</p>
                    <p class="mb-0"><strong>@item.EventDate.ToString("dd MMM yyyy")</strong> &middot; @item.Location</p>
                    <p class="mb-0">@item.Distance km &middot; @item.EventType</p>
                    <a asp-controller="Events" asp-action="Details" asp-route-id="@item.EventID" class="btn btn-primary btn-sm mt-3">View details</a>
                </div>
            </div>
        </div>
    }
</div>