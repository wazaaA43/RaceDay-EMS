@model List<RaceDayMVC.Models.EventModel>

@{
    ViewData["Title"] = "My Events";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">My Events</h1>
    <a asp-action="CreateEvent" class="btn btn-primary">Create event</a>
</div>

@if (ViewBag.ApiError != null)
{
    <div class="alert alert-danger">@ViewBag.ApiError</div>
}
else if (!Model.Any())
{
    <p class="text-muted">You have not created any events yet. Click "Create event" to add your first one.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Event</th>
                    <th>Date</th>
                    <th>Location</th>
                    <th>Distance</th>
                    <th>Type</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><a asp-controller="Events" asp-action="Details" asp-route-id="@item.EventID">@item.EventName</a></td>
                        <td>@item.EventDate.ToString("dd MMM yyyy")</td>
                        <td>@item.Location</td>
                        <td>@item.Distance km</td>
                        <td>@item.EventType</td>
                        <td class="text-end">
                            <a asp-action="EditEvent" asp-route-id="@item.EventID" class="btn btn-outline-primary btn-sm">Edit</a>
                            <a asp-action="DeleteEvent" asp-route-id="@item.EventID" class="btn btn-outline-danger btn-sm">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}