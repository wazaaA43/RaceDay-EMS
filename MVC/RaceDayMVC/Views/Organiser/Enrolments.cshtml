@model RaceDayMVC.Models.EnrolmentsViewModel

@{
    ViewData["Title"] = "Enrolments";
}

<a asp-action="Events" class="btn btn-link ps-0">&larr; Back to my events</a>

<h1>Enrolments</h1>
<p class="text-muted">@Model.Event.EventName &middot; @Model.Event.EventDate.ToString("dd MMM yyyy")</p>

@if (!Model.Enrolments.Any())
{
    <p class="text-muted">Nobody has enrolled in this event yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Participant</th>
                    <th>Email</th>
                    <th>Category</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Enrolments)
                {
                    var badge = item.Status == "Confirmed" ? "bg-success"
                    : item.Status == "Pending" ? "bg-warning text-dark"
                    : "bg-secondary";
                    var nextStatus = item.Status == "Confirmed" ? "Pending" : "Confirmed";
                    var buttonText = item.Status == "Confirmed" ? "Mark pending" : "Confirm";
                    var buttonClass = item.Status == "Confirmed" ? "btn-outline-secondary" : "btn-success";

                    <tr>
                        <td>@item.Participant?.FirstName @item.Participant?.LastName</td>
                        <td>@item.Participant?.Email</td>
                        <td>@item.Category?.CategoryName</td>
                        <td><span class="badge @badge">@item.Status</span></td>
                        <td class="text-end">
                            <form asp-action="SetEnrolmentStatus" method="post" class="d-inline">
                                <input type="hidden" name="enrolmentId" value="@item.EnrolmentID" />
                                <input type="hidden" name="eventId" value="@Model.Event.EventID" />
                                <input type="hidden" name="status" value="@nextStatus" />
                                <button type="submit" class="btn @buttonClass btn-sm">@buttonText</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}