@model RaceDayMVC.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    var upcoming = Model.Rows.Where(r => r.IsUpcoming).ToList();
    var past = Model.Rows.Where(r => !r.IsUpcoming).ToList();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Organiser Dashboard</h1>
    <a asp-action="CreateEvent" class="btn btn-primary">Create event</a>
</div>

@if (ViewBag.ApiError != null)
{
    <div class="alert alert-danger">@ViewBag.ApiError</div>
}

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <div class="display-6">@Model.TotalEvents</div>
                <div class="text-muted">Events created</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <div class="display-6">@Model.UpcomingEvents</div>
                <div class="text-muted">Upcoming events</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <div class="display-6">@Model.TotalEnrolments</div>
                <div class="text-muted">Total enrolments</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <div class="display-6">@Model.PendingEnrolments</div>
                <div class="text-muted">Awaiting confirmation</div>
            </div>
        </div>
    </div>
</div>

<h2 class="h4">Upcoming events</h2>

@if (!upcoming.Any())
{
    <p class="text-muted">You have no upcoming events. Click "Create event" to add one.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Event</th>
                    <th>Date</th>
                    <th>When</th>
                    <th>Enrolments</th>
                    <th>Pending</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in upcoming)
                {
                    <tr>
                        <td><a asp-controller="Events" asp-action="Details" asp-route-id="@row.Event.EventID">@row.Event.EventName</a></td>
                        <td>@row.Event.EventDate.ToString("dd MMM yyyy")</td>
                        <td>@(row.DaysUntil == 0 ? "Today" : row.DaysUntil == 1 ? "Tomorrow" : $"In {row.DaysUntil} days")</td>
                        <td>@row.TotalEnrolments</td>
                        <td>
                            @if (row.PendingEnrolments > 0)
                            {
                                <span class="badge bg-warning text-dark">@row.PendingEnrolments</span>
                            }
                            else
                            {
                                <span class="text-muted">&mdash;</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Enrolments" asp-route-id="@row.Event.EventID" class="btn btn-outline-secondary btn-sm">Enrolments</a>
                            <a asp-action="Categories" asp-route-id="@row.Event.EventID" class="btn btn-outline-secondary btn-sm">Categories</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<h2 class="h4 mt-4">Past events</h2>

@if (!past.Any())
{
    <p class="text-muted">No past events yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Event</th>
                    <th>Date</th>
                    <th>Enrolments</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in past)
                {
                    <tr>
                        <td>@row.Event.EventName</td>
                        <td>@row.Event.EventDate.ToString("dd MMM yyyy")</td>
                        <td>@row.TotalEnrolments</td>
                        <td class="text-end">
                            <a asp-action="Results" asp-route-id="@row.Event.EventID" class="btn btn-outline-secondary btn-sm">Results</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}