@model ErrorViewModel

@{
    ViewData["Title"] = "Something went wrong";
}

<div class="text-center py-5">
    <h1>Something went wrong</h1>
    <p class="text-muted">An unexpected problem occurred. Please try again, or go back to the events page.</p>

    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">Reference: <code>@Model.RequestId</code></p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to events</a>
</div>